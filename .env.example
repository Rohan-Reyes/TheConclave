# Isolated development ports and data; do not point at live databases.
CONCLAVE_PORT=4888
CONCLAVE_AUTH_FILE=/absolute/private/path/owner.json
CONCLAVE_ASSISTANT_ENABLED=1
AGENT_HUB_DATA_DIR=./private/coding
DATA_DIR=./private/assistant
APP_TIMEZONE=Asia/Manila
# Generate two different secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<independent-generated-64-hex-value>
TOKEN_ENCRYPTION_KEY=<independent-generated-64-hex-value>
# For deployment only, set the unified HTTPS origin after updating OAuth callbacks.
# CONCLAVE_PUBLIC_ORIGIN=https://conclave.aten-systems.site
