{
  "name": "conclave",
  "version": "2.0.0-preview",
  "private": true,
  "type": "module",
  "description": "Personal assistant and coding workspace",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "mcp": "node mcp/memory-server.js",
    "test": "node --test test/*.test.js",
    "test:live": "node scripts/test-live.mjs",
    "scan:staged": "node scripts/scan-staged.mjs",
    "worker": "node --env-file-if-exists=.env assistant/src/worker.js",
    "test:assistant": "node --test --test-concurrency=1 assistant/test/*.test.js",
    "setup": "node scripts/setup-unified.mjs",
    "test:chat-ui": "node scripts/check-chat-fixes.mjs",
    "format:check": "prettier --check src/config/globals.js src/context-updates.js public/views/globals.js test/globals.test.js test/skills-install.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "express": "^4.21.2",
    "luxon": "^3.7.2",
    "web-push": "^4.0.0",
    "ws": "^8.22.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.6.2"
  }
}
